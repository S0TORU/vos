#!/bin/zsh
# VOS — Voice Operating System CLI (sidecar; does not rewrite agent configs)
set -euo pipefail

VOS_REPO="${VOS_REPO:-$HOME/vos}"
VOS_HOME="${VOS_HOME:-$HOME/.vos}"
export VOS_REPO VOS_HOME

# Prefer repo bin helpers when running from source
PATH="$VOS_REPO/bin:$PATH"
export PATH

# Tool switchboard (hermes / prime / claude / …)
if [[ -f "$VOS_REPO/lib/tools.zsh" ]]; then
  # shellcheck disable=SC1091
  source "$VOS_REPO/lib/tools.zsh"
fi
if [[ -f "$VOS_REPO/lib/live_pulse.zsh" ]]; then
  # shellcheck disable=SC1091
  source "$VOS_REPO/lib/live_pulse.zsh"
fi

usage() {
  cat <<'EOF'
VOS — Voice Operating System

  vos install              Sync pack → ~/.vos and link ~/bin/vos
  vos recap                Boot briefing (memory + Ready)
  vos ask <text|->         Chat with DeepSeek Flash (Fireworks)
  vos plan <text>          Route: plan JSON → tool → summary (switchboard)
  vos listen [secs]        Mic → Whisper → smart route → speak
  vos talk [secs]          Multi-turn voice loop
  vos speak <text>         TTS only (read text aloud — not the live HUD)
  vos live                 Floating on-screen voice HUD (SuperWhisper-style)

Workers (direct tools — no config rewrite):
  vos tools                List allowlisted tools
  vos hermes <prompt>      Hermes agent one-shot
  vos prime <prompt>       Prime Agent harness one-shot
  vos claude <prompt>      Claude Code -p
  vos codex <prompt>       Codex one-shot (best-effort)
  vos gmail <query>        Gmail read-only via gws
  vos shell <cmd>          Restricted shell allowlist
  vos run <tool> [args]    Generic tool runner

  vos status | doctor      Health check

Environment:
  VOS_HOME, VOS_REPO, VOS_MODEL, VOS_CONDUCTOR, VOS_LLM_MODEL
  VOS_HERMES_MODEL / VOS_HERMES_PROVIDER  optional Hermes overrides
  VOS_PRIME_CWD / VOS_CLAUDE_CWD          default nfnexusgnn
  GROK_FIREWORKS_ENV                     default ~/.grok/.env.fireworks
EOF
}

have() { command -v "$1" >/dev/null 2>&1; }

# Default brain: DeepSeek V4 Flash on Fireworks via Grok Build (-m deepseek-flash)
VOS_CONDUCTOR="${VOS_CONDUCTOR:-deepseek}"
VOS_LLM_MODEL="${VOS_LLM_MODEL:-deepseek-flash}"

load_fireworks_env() {
  local env_file="${GROK_FIREWORKS_ENV:-$HOME/.grok/.env.fireworks}"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

resolve_grok() {
  if have grok; then command -v grok
  elif [[ -x "$HOME/.grok/bin/grok" ]]; then echo "$HOME/.grok/bin/grok"
  else echo ""
  fi
}

# Run a one-shot prompt through the conductor. Prints model text to stdout.
# Brain = DeepSeek Flash on Fireworks (via Grok Build CLI as the host — model is NOT xAI Grok weights).
# $2 = mode: "chat" (default, max-turns 1, stable on Fireworks) | "tools" (allow agent tools)
conductor_run() {
  local prompt="$1"
  local mode="${2:-chat}"
  if [[ "${VOS_CONDUCTOR}" == "offline" ]]; then
    return 1
  fi
  load_fireworks_env
  local g; g="$(resolve_grok)"
  if [[ -z "$g" ]]; then
    return 1
  fi
  if [[ -z "${FIREWORKS_API_KEY:-}" && "$VOS_LLM_MODEL" == deepseek* ]]; then
    echo "FIREWORKS_API_KEY missing (expected in ~/.grok/.env.fireworks)" >&2
    return 1
  fi
  mkdir -p "$VOS_HOME/state"
  local err="$VOS_HOME/state/conductor.err"
  local full
  full="[HOST] You are VOS (Voice OS). Inference: ${VOS_LLM_MODEL} on Fireworks (DeepSeek). Host CLI is Grok Build — do not claim to be xAI Grok the product. Be concise.
[TASK]
$prompt"
  # Fireworks + multi-turn tool loops can 400 (model_id field). Default chat = single turn.
  local -a args
  args=(-m "$VOS_LLM_MODEL" -p "$full")
  if [[ "$mode" == "tools" ]]; then
    args+=(--always-approve --max-turns 8)
  else
    args+=(--max-turns 1 --disable-web-search)
  fi
  if ! "$g" "${args[@]}" 2>"$err"; then
    if [[ -s "$err" ]]; then
      echo "conductor error (see $err)" >&2
      head -c 400 "$err" >&2 || true
      echo >&2
    fi
    return 1
  fi
}

resolve_whisper_model() {
  if [[ -n "${VOS_MODEL:-}" && -f "$VOS_MODEL" ]]; then
    echo "$VOS_MODEL"
    return
  fi
  local c
  for c in \
    "$HOME/.whisper-models/ggml-base.en.bin" \
    "$HOME/.whisper-models/ggml-small.en.bin" \
    "$HOME/Library/Application Support/superwhisper/ggml-small.en.bin" \
    /opt/homebrew/Cellar/whisper-cpp/*/share/whisper-cpp/for-tests-ggml-tiny.bin
  do
    # expand glob carefully
    for f in $~c(N); do
      if [[ -f "$f" ]]; then
        echo "$f"
        return
      fi
    done
  done
  echo ""
}

ensure_home() {
  if [[ ! -d "$VOS_HOME" ]]; then
    echo "VOS_HOME missing ($VOS_HOME). Run: vos install" >&2
    exit 1
  fi
}

cmd_install() {
  exec "$VOS_REPO/scripts/install.sh"
}

cmd_status() {
  load_fireworks_env
  echo "VOS_REPO=$VOS_REPO"
  echo "VOS_HOME=$VOS_HOME"
  echo "conductor: $VOS_CONDUCTOR"
  echo "llm model: $VOS_LLM_MODEL  (DeepSeek Flash via Fireworks)"
  echo -n "FIREWORKS_API_KEY: "
  if [[ -n "${FIREWORKS_API_KEY:-}" ]]; then echo "set"; else echo "MISSING"; fi
  echo -n "whisper-cli: "; have whisper-cli && whisper-cli --help >/dev/null 2>&1 && echo ok || echo MISSING
  echo -n "ffmpeg: "; have ffmpeg && echo ok || echo MISSING
  echo -n "say: "; have say && echo ok || echo MISSING
  local m; m="$(resolve_whisper_model)"
  echo "whisper model: ${m:-MISSING}"
  local g; g="$(resolve_grok)"
  echo "grok cli: ${g:-MISSING}"
  for t in claude codex prime-agent hermes orca gws; do
    if have "$t"; then echo "$t: ok"; else echo "$t: -"; fi
  done
  [[ -f "$VOS_HOME/SOUL.md" ]] && echo "soul: ok" || echo "soul: missing (run vos install)"
  [[ -f "$VOS_HOME/memory/MEMORY.md" ]] && echo "memory: ok" || echo "memory: missing"
}

load_context_blob() {
  local blob=""
  [[ -f "$VOS_HOME/SOUL.md" ]] && blob+=$'\n'"$(cat "$VOS_HOME/SOUL.md")"
  if [[ -d "$VOS_HOME/memory" ]]; then
    blob+=$'\n# MEMORY INDEX\n'
    [[ -f "$VOS_HOME/memory/MEMORY.md" ]] && blob+="$(cat "$VOS_HOME/memory/MEMORY.md")"
    # Load all sibling memory files (simple + reliable; no markdown parse)
    local f
    for f in "$VOS_HOME/memory"/*.md(N); do
      [[ "$(basename "$f")" == "MEMORY.md" ]] && continue
      blob+=$'\n--- '"$(basename "$f")"$' ---\n'"$(cat "$f")"
    done
  fi
  # Distilled live signals (TODO, git, Claude MEMORY index stars) — not full jsonl
  if typeset -f vos_build_live_pulse >/dev/null 2>&1; then
    blob+=$'\n\n'"$(vos_build_live_pulse)"
  fi
  printf '%s' "$blob"
}

cmd_recap() {
  ensure_home
  local skill="$VOS_HOME/skills/recap/SKILL.md"
  [[ -f "$skill" ]] || skill="$VOS_REPO/pack/skills/recap/SKILL.md"
  local ctx; ctx="$(load_context_blob)"
  local prompt
  prompt="Deliver the boot briefing NOW from LOADED CONTEXT only. Do not call tools. Do not read files.

Prefer LIVE PULSE over static project_lura boilerplate when they disagree (pulse has git branch, TODO Now, Claude memory stars).
Keep sections short and voice-friendly.
Sections: Who you are; Environment; What we've been building; Current state; What's next; Watch items.
End with Ready.

# SKILL (format only)
$(cat "$skill")

# LOADED CONTEXT (already inlined — use this only)
$ctx"

  mkdir -p "$VOS_HOME/state"
  local out=""
  out="$(conductor_run "$prompt" chat || true)"
  if [[ -z "${out// }" ]]; then
    out="$(offline_recap)"
  fi
  printf '%s\n' "$out" | tee "$VOS_HOME/state/last_briefing.md"
}

offline_recap() {
  cat <<EOF
## Who you are
Aanuoluwapo Oshakuade — Elyris / LURA founder. VOS is your personal voice OS sidecar.

## Environment
- Host: $(hostname -s 2>/dev/null || hostname)
- VOS_HOME: $VOS_HOME
- Conductor: $VOS_CONDUCTOR / $VOS_LLM_MODEL
- Grok CLI: $(resolve_grok || echo offline)
- Whisper model: $(resolve_whisper_model || echo none)

## What we've been building
See ~/.vos/memory project files (LURA + VOS). Offline mode: no model synthesis.

## Current state
Memory pack installed. Run with Grok available for a full briefing.

## What's next
- vos ask "..."
- vos listen  (voice)
- Wire gmail / workers when ready

## Watch items
Do not rewrite agent global configs. Confirm before send/push/spend.

Ready.
EOF
}

# True if text should use the plan→tool switchboard
vos_wants_router() {
  local lower="${1:l}"
  [[ "$lower" == *hermes* \
    || "$lower" == *prime* \
    || "$lower" == *claude* \
    || "$lower" == *codex* \
    || "$lower" == *gmail* \
    || "$lower" == *inbox* \
    || "$lower" == *email* \
    || "$lower" == *"dispatch"* \
    || "$lower" == *"run "* \
    || "$lower" == *"execute"* \
    || "$lower" == *"hand off"* \
    || "$lower" == *"handoff"* \
    || "$lower" == *"use hermes"* \
    || "$lower" == *"use prime"* \
    || "$lower" == *"spin up"* ]]
}

cmd_plan() {
  ensure_home
  if ! typeset -f vos_plan_and_run >/dev/null 2>&1; then
    echo "tools.zsh not loaded (missing $VOS_REPO/lib/tools.zsh)" >&2
    exit 1
  fi
  vos_plan_and_run "$@"
}

cmd_ask() {
  ensure_home
  local user_text=""
  if [[ "${1:-}" == "-" ]]; then
    user_text="$(cat)"
  else
    user_text="$*"
  fi
  if [[ -z "${user_text// }" ]]; then
    echo "usage: vos ask <text> | vos ask -" >&2
    exit 1
  fi

  local lower="${user_text:l}"
  if [[ "$lower" == *"recap"* && ${#user_text} -lt 40 ]]; then
    cmd_recap
    return
  fi

  # Auto-route when user names a worker or dispatch intent
  if vos_wants_router "$user_text" && typeset -f vos_plan_and_run >/dev/null 2>&1; then
    vos_plan_and_run "$user_text"
    return
  fi

  local ctx; ctx="$(load_context_blob)"
  local prompt="You are VOS, a personal Mac operating agent.
Follow SOUL and memory. Prefer short voice-friendly answers.
If the user needs Hermes/Prime/Claude/Gmail, tell them to say the worker name or use vos plan.
Confirm before send_email, git_push, cloud_spend, destructive actions.

# CONTEXT
$ctx

# USER
$user_text
"

  mkdir -p "$VOS_HOME/state/sessions"
  local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  local session="$VOS_HOME/state/sessions/${ts}.md"
  {
    echo "# session $ts"
    echo "## user"
    echo "$user_text"
    echo "## assistant"
  } >"$session"

  local out=""
  out="$(conductor_run "$prompt" chat || true)"
  if [[ -z "${out// }" ]]; then
    out="(offline) Heard: $user_text

DeepSeek conductor did not respond. Check:
  vos status
  FIREWORKS_API_KEY in ~/.grok/.env.fireworks
  grok -m deepseek-flash -p \"ping\"
  cat ~/.vos/state/conductor.err
"
  fi
  printf '%s\n' "$out" | tee -a "$session"
}

cmd_speak() {
  # TTS only — for floating live agent use: vos live
  if [[ -z "${1:-}" ]]; then
    echo "vos speak = text-to-speech only." >&2
    echo "For floating on-screen voice agent:  vos live" >&2
    exit 1
  fi
  local text="$*"
  if have say; then
    local clean
    clean="$(printf '%s' "$text" | sed -E 's/`//g; s/\*\*//g; s/^#+ //g' | head -c 4000)"
    say "$clean"
  else
    echo "$text"
  fi
}

cmd_live() {
  ensure_home
  local bin="$VOS_REPO/dist/VOSLive"
  if [[ ! -x "$bin" ]]; then
    echo "Building floating HUD…" >&2
    mkdir -p "$VOS_REPO/dist"
    if ! have swiftc; then
      echo "swiftc missing — falling back to Terminal talk loop" >&2
      exec "$VOS_REPO/bin/vos" talk "${1:-25}"
    fi
    swiftc -O -o "$bin" "$VOS_REPO/macos/VOSLive.swift" -framework Cocoa 2>"$VOS_HOME/state/build-hud.err" || {
      echo "HUD build failed (see ~/.vos/state/build-hud.err). Fallback: vos talk" >&2
      exec "$VOS_REPO/bin/vos" talk "${1:-25}"
    }
  fi
  echo "Opening floating VOS HUD…" >&2
  # Run as accessory app (stays floating)
  nohup "$bin" >/tmp/vos-live.log 2>&1 &
  disown 2>/dev/null || true
  echo "HUD pid $!  — click Talk on the floating panel. Log: /tmp/vos-live.log"
}

cmd_listen() {
  ensure_home
  local secs="${1:-30}"
  if ! have ffmpeg || ! have whisper-cli; then
    echo "Need ffmpeg + whisper-cli for local STT. vos status" >&2
    exit 1
  fi
  local model; model="$(resolve_whisper_model)"
  if [[ -z "$model" ]]; then
    echo "No whisper model found. Put ggml-*.bin in ~/.whisper-models/" >&2
    exit 1
  fi

  mkdir -p "$VOS_HOME/state"
  local wav="$VOS_HOME/state/last_listen.wav"
  echo "Listening ${secs}s (local mic)… speak, then wait." >&2
  # avfoundation :0 default mic on macOS; silence on fail
  if ! ffmpeg -y -hide_banner -loglevel error \
      -f avfoundation -i ":0" -t "$secs" -ar 16000 -ac 1 "$wav" 2>/tmp/vos-ffmpeg.err; then
    echo "Mic capture failed. See /tmp/vos-ffmpeg.err — grant Terminal mic permission if needed." >&2
    cat /tmp/vos-ffmpeg.err >&2 || true
    exit 1
  fi

  echo "Transcribing…" >&2
  local transcript
  transcript="$(whisper-cli -m "$model" -f "$wav" -nt 2>/dev/null | sed '/^$/d' | tail -n +1)"
  # whisper-cli often prints timestamps; take last non-empty text lines
  transcript="$(printf '%s\n' "$transcript" | sed -E 's/\[[0-9:.]+ --> [0-9:.]+\]//g' | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')"
  if [[ -z "${transcript// }" ]]; then
    echo "Empty transcript." >&2
    exit 1
  fi
  echo "You: $transcript" >&2
  local answer
  answer="$(cmd_ask "$transcript")"
  printf '%s\n' "$answer"
  cmd_speak "$answer" || true
}

cmd_talk() {
  local secs="${1:-25}"
  echo "VOS talk loop. Say stop / goodbye to exit." >&2
  while true; do
    local answer
    if ! answer="$(cmd_listen "$secs")"; then
      echo "listen failed; retrying in 1s…" >&2
      sleep 1
      continue
    fi
    local lower="${answer:l}"
    # Also check last user transcript is awkward; check spoken stop in answer path via state
    # Simpler: re-read last session user line
    local last_user
    last_user="$(ls -t "$VOS_HOME/state/sessions"/*.md 2>/dev/null | head -1 | xargs -I{} sed -n '/^## user$/,/^## assistant$/p' {} 2>/dev/null | sed '1d;$d' | tr '\n' ' ')"
    local ul="${last_user:l}"
    if [[ "$ul" == *stop* || "$ul" == *goodbye* || "$ul" == *cancel* || "$ul" == *"that's all"* || "$ul" == *"thats all"* ]]; then
      cmd_speak "Shutting down VOS voice loop. Ready when you are."
      echo "Bye." >&2
      break
    fi
  done
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 0; }
  shift || true
  case "$cmd" in
    install) cmd_install "$@" ;;
    recap) cmd_recap "$@" ;;
    ask) cmd_ask "$@" ;;
    plan|route) cmd_plan "$@" ;;
    listen) cmd_listen "$@" ;;
    talk) cmd_talk "$@" ;;
    speak) cmd_speak "$@" ;;
    live|hud|float) cmd_live "$@" ;;
    tools) vos_tools_list ;;
    hermes) vos_tool_hermes "$@" ;;
    prime|prime-agent) vos_tool_prime "$@" ;;
    claude) vos_tool_claude "$@" ;;
    codex) vos_tool_codex "$@" ;;
    gmail) vos_tool_gmail "$@" ;;
    shell) vos_tool_shell "$@" ;;
    run) vos_tool_run "$@" ;;
    status|doctor) cmd_status "$@" ;;
    -h|--help|help) usage ;;
    *)
      # Bare text: treat as ask (may auto-route if worker named)
      cmd_ask "$cmd" "$@"
      ;;
  esac
}

main "$@"
